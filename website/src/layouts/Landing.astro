---
import '~/assets/styles/tailwind.css';
import '~/assets/styles/poligontek.css';
import Brand from '~/components/Brand.astro';
import Button from '~/components/ui/Button.astro';
import Headline from '~/components/ui/Headline.astro';
import {content, languages, paths, type Language} from '~/data/content';
import {site} from '~/data/site';
interface Props { lang: Language }
const {lang}=Astro.props;
const t=content[lang];
const canonical=site.url+paths[lang];
const anchors=['servicios','trabajos','proceso','contacto'];
const projectUrl='https://realfat32.poligontek.com'+paths[lang];
const locale={es:'es_ES',en:'en_US',pt:'pt_BR'};
const schema={'@context':'https://schema.org','@type':'Organization',name:'PoligonTek',url:site.url,logo:site.url+'/favicon.svg',sameAs:[site.github],founder:{'@type':'Person',name:'Fabian Gonzalez Dev'},knowsLanguage:['es','en','pt'],hasOfferCatalog:{'@type':'OfferCatalog',name:t.servicesLabel,itemListElement:t.services.map(s=>({'@type':'Offer',itemOffered:{'@type':'Service',name:s.title,description:s.text}}))}};
---
<!doctype html>
<html lang={lang}>
 <head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t.title}</title>
  <meta name="description" content={t.description} />
  <meta name="author" content="PoligonTek · Fabian Gonzalez Dev" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="theme-color" content="#2545d4" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
  {languages.map(l=><link rel="alternate" hreflang={l} href={site.url+paths[l]} />)}
  <link rel="alternate" hreflang="x-default" href={site.url+'/'} />
  <meta property="og:type" content="website" /><meta property="og:site_name" content="PoligonTek" />
  <meta property="og:title" content={t.title} /><meta property="og:description" content={t.description} />
  <meta property="og:url" content={canonical} /><meta property="og:locale" content={locale[lang]} />
  <meta property="og:image" content={site.url+'/images/social-card.png'} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta property="og:image:alt" content="PoligonTek · Software, apps & web" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={t.title} /><meta name="twitter:description" content={t.description} /><meta name="twitter:image" content={site.url+'/images/social-card.png'} />
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')} />
 </head>
 <body>
  <a class="skip-link" href="#inicio">{t.skip}</a>
  <header class="site-header">
   <div class="container header-inner">
    <Brand />
    <nav aria-label={t.menu} id="main-nav">
     {anchors.map((id,i)=><a href={'#'+id}>{t.nav[i]}</a>)}
    </nav>
    <div class="header-tools">
     <details class="language-menu"><summary aria-label={t.language+': '+lang.toUpperCase()}>{lang.toUpperCase()} <svg width="12" height="12" viewBox="0 0 20 20" aria-hidden="true"><path d="m5 7 5 5 5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg></summary><div class="language-options">{languages.map(l=><a href={paths[l]} lang={l} hreflang={l} aria-current={l===lang?'page':undefined}>{({es:'Español',en:'English',pt:'Português'})[l]}</a>)}</div></details>
     <button class="menu-toggle" type="button" aria-controls="main-nav" aria-expanded="false" aria-label={t.menu}><span></span><span></span></button>
    </div>
   </div>
  </header>
  <main>
   <section class="hero container" id="inicio">
    <div class="hero-copy">
     <p class="eyebrow">{t.eyebrow}</p>
     <h1>{t.hero}<br /><span>{t.heroAccent}</span></h1>
     <p class="hero-intro">{t.intro}</p>
     <div class="actions"><Button variant="primary" text={t.talk} href="#contacto" /><a class="text-link" href="#trabajos">{t.seeWork}</a></div>
     <p class="hero-note">{t.heroNote}</p>
    </div>
    <div class="hero-visual" aria-hidden="true">
     <div class="visual-top"><span>POLIGONTEK</span><svg width="33" height="33" viewBox="0 0 32 32"><path d="m16 2 13 7v14l-13 7L3 23V9Z M3 9l13 7 13-7 M16 16v14" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></div>
     <div class="visual-words">{t.visualWords.map((word,i)=><span class:list={[i===2&&'outlined']}>{word}</span>)}</div>
     <div class="visual-bottom"><span>{t.visualLabel}</span><span class="visual-line"></span></div>
     <div class="visual-tab">{t.visualFoot}</div>
    </div>
   </section>
   <section class="services section container" id="servicios">
    <Headline tagline={t.servicesLabel} title={t.servicesTitle} subtitle={t.servicesIntro} classes={{container:'section-heading',title:'section-title',subtitle:'section-intro'}} />
    <div class="service-grid">{t.services.map(s=><article class="service"><div class="service-icon" aria-hidden="true"><svg width="28" height="28" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">{s.icon==='software'?<><path d="m11 9-7 7 7 7m10-14 7 7-7 7M18 5l-4 22" /></>:s.icon==='app'?<><rect x="5" y="3" width="22" height="26" rx="4"/><path d="M5 10h22M10 6.5h1m3 0h1M11 16h10m-10 5h7"/></>:<><rect x="2" y="5" width="28" height="22" rx="3"/><path d="M2 12h28M12 12v15M6 8.5h1m3 0h1"/></>}</svg></div><h3>{s.title}</h3><p>{s.text}</p><ul>{s.tags.map(tag=><li>{tag}</li>)}</ul></article>)}</div>
   </section>
   <section class="work section" id="trabajos">
    <div class="container">
     <div class="work-heading"><p class="eyebrow">{t.worksLabel}</p><h2>{t.worksTitle}</h2><p class="section-intro">{t.worksIntro}</p></div>
     <article class="project">
      <div class="project-visual"><div class="project-browser"><div class="browser-bar" aria-hidden="true"><span class="browser-dots"><i></i><i></i><i></i></span><span>RealFat32</span><span>Windows</span></div><img src={'/images/realfat32-'+lang+'.webp'} alt={t.imageAlt} width="776" height="809" loading="lazy" decoding="async" /></div><span class="project-stamp">FAT32<br/><strong>{t.projectDetails[0]}</strong></span></div>
      <div class="project-copy"><p class="eyebrow">{t.projectLabel}</p><h3>{t.projectTitle}</h3><p>{t.projectDesc}</p><ul class="project-details">{t.projectDetails.map(detail=><li>{detail}</li>)}</ul><Button variant="primary" text={t.projectCta} href={projectUrl} target="_blank" /><a class="text-link source-link" href="https://github.com/poligontek/RealFat32" target="_blank" rel="noopener noreferrer">{t.source}</a><p class="project-alpha">{t.alpha}</p></div>
     </article>
    </div>
   </section>
   <section class="process section container" id="proceso">
    <Headline tagline={t.processLabel} title={t.processTitle} subtitle={t.processIntro} classes={{container:'section-heading',title:'section-title',subtitle:'section-intro'}} />
    <div class="process-grid">{t.steps.map(step=><article><span class="process-marker" aria-hidden="true"></span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div>
   </section>
   <section class="contact section" id="contacto">
    <div class="container contact-inner"><div><p class="eyebrow">{t.contactLabel}</p><h2>{t.contactTitle}</h2><p>{t.contactText}</p></div><div class="contact-action"><Button variant="primary" text={site.contactEmail?t.contactEmail:t.githubContact} href={site.contactEmail?'mailto:'+site.contactEmail:site.github} target={site.contactEmail?undefined:'_blank'} /><p>{site.contactEmail||t.contactNote}</p></div></div>
   </section>
  </main>
  <footer class="site-footer container"><div class="footer-top"><div><Brand /><p>{t.footer}</p></div><div class="footer-links"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a><a href={projectUrl}>RealFat32</a><button type="button" id="open-privacy">{t.privacy}</button><a href="#inicio">{t.top}</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} PoligonTek</span><span>{t.created}</span></div></footer>
  <dialog id="privacy-dialog" aria-labelledby="privacy-title"><h2 id="privacy-title">{t.privacy}</h2><p>{t.privacyText}</p><form method="dialog"><Button variant="primary" type="submit" text={t.close} /></form></dialog>
  <script>
   const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');
   const nav=document.getElementById('main-nav');
   toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('is-open',open);});
   nav?.querySelectorAll('a').forEach(link=>link.addEventListener('click',()=>{toggle?.setAttribute('aria-expanded','false');nav.classList.remove('is-open');}));
   document.addEventListener('keydown',event=>{if(event.key==='Escape'){nav?.classList.remove('is-open');toggle?.setAttribute('aria-expanded','false');document.querySelector<HTMLDetailsElement>('.language-menu')?.removeAttribute('open');}});
   document.getElementById('open-privacy')?.addEventListener('click',()=>document.querySelector<HTMLDialogElement>('#privacy-dialog')?.showModal());
  </script>
 </body>
</html>
